            const minutes = Math.floor(remainingTime / 60);
            const seconds = remainingTime % 60;
            element.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        };

        updateDisplay(); // Display initial time

        const interval = setInterval(() => {
            remainingTime -= 1;
            updateDisplay(); // Update countdown display

            if (remainingTime <= 0) {
                clearInterval(interval);
                element.textContent = "Time's up!"; // Final message
            }
        }, 1000); // Update every second
    }

      function initializeCountdowns() {
        const countdownElements = document.querySelectorAll('span[id^="countdown-"]');
        
        countdownElements.forEach((element) => {
            const randomMinutes = Math.floor(Math.random() * 4) + 6;
            const randomSeconds = Math.floor(Math.random() * 60);
            const totalSeconds = (randomMinutes * 60) + randomSeconds;

            startCountdown(element, totalSeconds);
        });
    }

